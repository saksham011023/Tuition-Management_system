# ─────────────────────────────────────
# Application
# ─────────────────────────────────────
APP_NAME="Tuition Management System"
APP_ENV=development # development, testing, production
DEBUG=true
LOG_LEVEL=INFO # DEBUG, INFO, WARNING, ERROR, CRITICAL

# ─────────────────────────────────────
# Database (SQLite / PostgreSQL)
# ─────────────────────────────────────
# For local dev SQLite, use e.g. sqlite+aiosqlite:///./tms.db
# For production PostgreSQL, use e.g. postgresql+asyncpg://postgres:postgres@postgres:5432/tms_db
DATABASE_URL=sqlite+aiosqlite:///./tms.db

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tms_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ─────────────────────────────────────
# Backups
# ─────────────────────────────────────
BACKUP_DIR=./backups

# ─────────────────────────────────────
# JWT Authentication
# ─────────────────────────────────────
JWT_SECRET_KEY=change-this-to-a-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─────────────────────────────────────
# CORS
# ─────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# ─────────────────────────────────────
# Frontend (Next.js)
# ─────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_APP_NAME="Tuition Management System"
